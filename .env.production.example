# Immersive Episteme: PRODUCTION environment template (Vercel, Production target).
#
# Copy it OUTSIDE the repository and fill it in there, for example:
#   %USERPROFILE%\.episteme\production.env
# Never name a filled copy `.env.production` or `.env.production.local` in the repo root: Next.js
# loads those files automatically, so a local `next build`/`next start` would talk to production.
# This template holds no values. Never commit a filled copy. Never paste values into chat.
#
# Then:
#   npx tsx scripts/deploy/preflight.ts --env-file %USERPROFILE%\.episteme\production.env
#   powershell -File scripts\deploy\push-env.ps1 -EnvFile %USERPROFILE%\.episteme\production.env -BuildVersionFromGit -DryRun
# Full order of steps: docs/deploy/RUNBOOK.md. Facts and sources: docs/deploy/RESEARCH.md.
#
# Do NOT set on Vercel (preflight and push-env refuse them):
#   NODE_ENV (Next.js sets production), TEST_DATABASE_URL, AUTH_TRUSTED_PROXIES,
#   MEDIA_LOCAL_DIR, AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
#   AWS_SESSION_TOKEN (Vercel injects placeholders that "are not usable as AWS credentials"),
#   any VERCEL_* name, ADMIN_PASSWORD.
# Invite-only access needs NO extra variable: the invite gate (source change S11) signs its cookie
# with BETTER_AUTH_SECRET and keeps codes in the database (Admin > Access). Every Vercel build
# runs scripts/deploy/invite-gate.ts first (vercel.json buildCommand).

# --- Database (Neon PostgreSQL 18, AWS Asia Pacific (Singapore) aws-ap-southeast-1) --- SECRET ---
# RUNBOOK step 1: the episteme_app role (never the Neon owner role) and the password you set for it
# in SQL. Use hex, so it needs no URL-encoding inside the URL:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# POOLED string (host has -pooler) for the app's connection pool:
# Shape: postgresql://episteme_app:<password>@ep-<name>-pooler.ap-southeast-1.aws.neon.tech/episteme?sslmode=verify-full
DATABASE_URL=
# DIRECT string (same host WITHOUT -pooler) for the dashboard's LISTEN connection and migrations.
# Neon's pooler is PgBouncer in transaction mode and does not support LISTEN/NOTIFY.
# Shape: postgresql://episteme_app:<password>@ep-<name>.ap-southeast-1.aws.neon.tech/episteme?sslmode=verify-full
DATABASE_URL_UNPOOLED=

# --- RDS root CA: leave EMPTY on Neon ------------------------------------------------- CONFIG ---
# Neon's certificate chains to ISRG Root X1 (Let's Encrypt), which is in Node's default store.
# Only for an RDS host (ap-south-1 bundle, RESEARCH.md section 8).
DATABASE_CA_PEM=

# Connections per Vercel function instance (RESEARCH.md section 6).
DB_POOL_MAX=3

# --- Auth ----------------------------------------------------------------------------- SECRET ---
# A NEW value for production, never the local one (preflight compares them):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# src/lib/env.ts rejects < 43 characters, < 16 distinct characters and placeholder words.
# Rotating it signs every staff, participant and invite cookie out.
BETTER_AUTH_SECRET=

# The production origin, https, no path. The lead's domain, or the project's *.vercel.app domain.
BETTER_AUTH_URL=

# Sign-in rate limiting keys on the client IP. Vercel overwrites X-Forwarded-For
# (RESEARCH.md section 11), so trust that header and leave AUTH_TRUSTED_PROXIES unset.
AUTH_CLIENT_IP_HEADER=x-forwarded-for

# --- Build stamp -------------------------------------------------------------------- CONFIG ---
# Git short SHA of the deployed commit (telemetry and study records carry it). push-env.ps1
# -BuildVersionFromGit fills it from `git rev-parse --short HEAD`. Until source change S12 lands,
# that SHA must be the commit production builds: fast-forward the production branch to it (a merge
# commit or squash has a different SHA, and study records would carry the wrong version).
APP_BUILD_VERSION=

# --- Public demo ---------------------------------------------------------------------- CONFIG ---
# auto = /explore is off while any real study is active. The invite gate applies in every mode.
PUBLIC_DEMO=auto

# --- CMS media (Cloudflare R2, private bucket) ------------------------------------- CONFIG ---
# RUNBOOK step 2. The endpoint origin goes into the CSP connect-src at BUILD time, so set these
# before the first build. (AWS S3 instead: drop ENDPOINT and FORCE_PATH_STYLE, region ap-south-1.)
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
MEDIA_S3_FORCE_PATH_STYLE=true

# --- R2 credentials: an R2 API token, Object Read & Write, this bucket only -------------- SECRET ---
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
