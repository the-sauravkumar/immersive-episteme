# Copy to .env and adjust. .env is gitignored.

# Postgres (docker compose service "db", host port 5433)
DATABASE_URL=postgres://episteme:episteme_dev_password@localhost:5433/episteme
# Separate database for integration tests (created by docker/postgres/initdb/01-create-test-db.sql)
TEST_DATABASE_URL=postgres://episteme:episteme_dev_password@localhost:5433/episteme_test
# Production on Neon: DATABASE_URL is the POOLED string (host ep-...-pooler...), and the DIRECT one
# goes here; the dashboard's LISTEN connection and the db:* scripts use it (Neon's pooler does not
# support LISTEN/NOTIFY). Leave unset locally: DATABASE_URL then serves everything.
# DATABASE_URL_UNPOOLED=
# Production on Amazon RDS: the PEM CA bundle for the region (ap-south-1-bundle.pem, about 4.6 KB),
# in double quotes. Required in production when the host ends in .rds.amazonaws.com. When set,
# TLS is verified against exactly this CA and sslmode/sslrootcert are removed from DATABASE_URL.
# DATABASE_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Better Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The placeholder below is deliberately rejected at startup (src/lib/env.ts): replace it.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Stamped into telemetry/study records so every event is attributable to a build. When unset,
# Vercel deployments use the short VERCEL_GIT_COMMIT_SHA (the deployed commit), else "dev".
APP_BUILD_VERSION=dev

# Sign-in rate limiting keys on the client IP. Leave both unset when the app is reached
# directly (client-supplied forwarding headers are then stripped and the socket address is
# used). Behind a reverse proxy, list its address(es) / CIDR(s); set the header if the proxy
# uses one other than X-Forwarded-For (e.g. cf-connecting-ip, x-real-ip).
# AUTH_TRUSTED_PROXIES=10.0.0.10,10.0.1.0/24
# AUTH_CLIENT_IP_HEADER=x-forwarded-for

# Public demo (/explore): auto = off while any real study is active (default), on, off.
# PUBLIC_DEMO=auto

# The site is always invite-only (Admin -> Access). The invite cookie is signed with
# BETTER_AUTH_SECRET, so there is no separate variable; rotating the secret signs everyone out.

# CMS media storage (validated in src/server/cms/media/storage.ts). Leave MEDIA_S3_BUCKET unset to
# store uploads on local disk under MEDIA_LOCAL_DIR (default .data/media; must be set explicitly in
# production). With a bucket set, browsers upload directly to it and its origin is added to the
# CSP connect-src (src/lib/security/csp.ts).
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_FORCE_PATH_STYLE=false
# MEDIA_LOCAL_DIR=.data/media
