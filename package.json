{
  "name": "immersive-episteme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project dom --project node",
    "test:content": "vitest run --project content",
    "test:watch": "vitest --project dom --project node",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:seed:reference": "tsx scripts/db/seed-reference.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:studio": "drizzle-kit studio",
    "create-admin": "tsx scripts/create-admin.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "content:import": "tsx scripts/content/import.ts",
    "content:bootstrap:remote": "tsx scripts/content/bootstrap-remote.ts",
    "spatial:compile": "tsx scripts/spatial/publish-manifest.ts",
    "dev:bootstrap": "npm run db:up && tsx scripts/dev/bootstrap.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@hookform/resolvers": "5.9.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tanstack/react-query": "5.104.2",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-character-count": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@xyflow/react": "12.12.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "echarts": "6.1.0",
    "gsap": "3.15.0",
    "isomorphic-dompurify": "4.5.0",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@esbuild-kit/esm-loader": "file:tools/npm-stubs/esbuild-kit-esm-loader",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "stats-gl": {
      "three": "$three"
    },
    "drizzle-kit": {
      "@esbuild-kit/esm-loader": "$@esbuild-kit/esm-loader"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
